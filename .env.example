POSTGRES_DB=ticketing
POSTGRES_USER=ticketing
POSTGRES_PASSWORD=ticketing123
POSTGRES_PORT=5432

APP_PORT=3000
DATABASE_URL=postgresql://ticketing:ticketing123@localhost:5432/ticketing?sslmode=disable
DATABASE_SSL=false

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

JWT_SECRET=
COOKIE_SECURE=false

MASKING_PROPS=

# Provider AI: openai-compatible (alias didukung: openai, open-ai, openai-compat, openai_api) ATAU ollama
AI_PROVIDER=openai-compatible

# Contoh untuk OpenAI-compatible endpoint (biasanya diakhiri /v1):
# AI_BASE_URL=https://api.openai.com/v1
# Contoh untuk Ollama (TANPA /v1, di dalam container gunakan host.docker.internal / host.containers.internal):
# AI_BASE_URL=http://host.containers.internal:11434

# API key (opsional untuk Ollama, biasanya diisi untuk endpoint OpenAI-compatible)
# AI_API_KEY=sk-xxx

# Nama model yang digunakan (required)
# AI_MODEL=gpt-4o-mini
# AI_MODEL=llama3.1

AI_SYSTEM_EMAIL=ai-support@local
AI_SYSTEM_NAME="AI Support"
AI_TEMPERATURE=0.2
AI_MAX_TOKENS=400
AI_TIMEOUT_MS=30000
